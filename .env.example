# Public site URL (canonical, OG tags, sitemap). No trailing slash.
PUBLIC_SITE_URL=http://localhost:4321

# ─── StudioLayer headless CMS ────────────────────────────────────────────────
# Your StudioLayer Content API key.
# Store the real value as a secret in your host's env, never hardcoded in the repo.
STUDIOLAYER_API_KEY=

# Studiolayer API base URL (app origin). Defaults to the hosted deployment.
STUDIOLAYER_BASE_URL=https://app.studiolayer.io

# Project slug in StudioLayer (determines the default media bucket, among others).
STUDIOLAYER_PROJECT=

# ─── Media cloaking (/cdn/<uuid>) ────────────────────────────────────────────
# CDN origin where the StudioLayer media lives. Used server-side only,
# never leaks to the client. Usually no need to change.
STUDIOLAYER_CDN_ORIGIN=https://cdn.studiolayer.io

# Bucket prefix for bare keys (/cdn/<uuid> -> <bucket>/<uuid>).
# Default: production/projects/<STUDIOLAYER_PROJECT>/
# Only set this if you use a non-standard bucket.
# STUDIOLAYER_CDN_BUCKET=
