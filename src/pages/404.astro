---
import Base from '@/layouts/Base.astro';
---
<Base title="404 - Not found" description="This page could not be found.">
  <main class="grid min-h-dvh place-items-center px-6 text-center">
    <div>
      <p class="font-mono text-sm tracking-widest text-neutral-500">404</p>
      <h1 class="mt-3 text-3xl font-semibold">Page not found</h1>
      <p class="mt-2 text-neutral-500">The page you are looking for does not exist or has moved.</p>
      <a href="/" class="mt-6 inline-block rounded-md border border-neutral-300 px-4 py-2 text-sm hover:bg-neutral-100">
        Back home
      </a>
    </div>
  </main>
</Base>
