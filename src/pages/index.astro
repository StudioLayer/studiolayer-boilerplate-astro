---
import Base from '@/layouts/Base.astro';
// import { studio } from '@/lib/studio';
// import CmsImage from '@/components/CmsImage.astro';

// Example: fetch content from StudioLayer.
// const posts = await studio.dataset('blog', 'posts').list();

const title = 'StudioLayer Astro Boilerplate';
const description = 'Astro 5 SSR + StudioLayer headless CMS, with same-origin media cloaking.';
---
<Base title={title} description={description}>
  <main class="mx-auto max-w-2xl px-6 py-24">
    <h1 class="text-4xl font-bold tracking-tight">{title}</h1>
    <p class="mt-4 text-lg opacity-70">{description}</p>

    <ul class="mt-10 space-y-2 text-sm">
      <li>✓ Astro 5 SSR (node standalone adapter)</li>
      <li>✓ Tailwind 4 via <code>@tailwindcss/vite</code></li>
      <li>✓ StudioLayer client in <code>src/lib/studio.ts</code></li>
      <li>✓ Media cloaking at <code>/cdn/&lt;uuid&gt;</code> (resize + cache)</li>
      <li>✓ Prod-ready Docker (multi-stage)</li>
    </ul>

    <p class="mt-10 text-sm opacity-60">
      Copy <code>.env.example</code> to <code>.env</code>, fill in your StudioLayer key,
      and start with <code>npm run dev</code>. See <code>README.md</code>.
    </p>
  </main>
</Base>
